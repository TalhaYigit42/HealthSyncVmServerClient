# Copy this file to .env and fill in your values.
# Then: source .env && python pipeline.py

# ---- Google Drive ----
# The ID at the end of your Drive folder URL:
# https://drive.google.com/drive/folders/<THIS_PART>
export GDRIVE_FOLDER_ID="your_google_drive_folder_id_here"

# Path to the OAuth2 credentials file downloaded from Google Cloud Console.
# Default: ./credentials.json  (project root)
# export GDRIVE_CREDENTIALS_PATH="/path/to/credentials.json"

# ---- Scheduler ----
# How often (in minutes) the pipeline runs. Default: 15
# export PIPELINE_INTERVAL_MIN=15

# ---- Database (already defaults to the correct values) ----
# export DB_HOST=localhost
# export DB_NAME=healthsync
# export DB_USER=healthsync_user
# export DB_PASSWORD=Bartal123!
# export DB_PORT=5432
